generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String?
  passwordHash  String
  role          String     @default("user") // user | admin
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  businesses    Business[]
  subscriptions Subscription[]
  payments      Payment[]
}

model Business {
  id                String        @id @default(cuid())
  userId            String
  name              String
  industry          String
  contextData       String        @default("") // Knowledge base
  systemPrompt      String        @default("") // Generated AI prompt
  apiKey            String        @unique @default(cuid())
  subscriptionStatus String       @default("free") // free | starter | pro | agency
  agentLimit        Int           @default(1)
  leadLimit         Int           @default(10)
  whatsappNumber    String?       // Connected WhatsApp number
  whatsappInstance  String?       // Evolution API instance name
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  leads             Lead[]
  agents            Agent[]
  conversations     Conversation[]
  workflows         Workflow[]
  knowledgeDocs     KnowledgeDoc[]

  @@index([userId])
}

model Agent {
  id           String   @id @default(cuid())
  businessId   String
  name         String
  type         String   // whatsapp | barista | knowledge | leadgen | content | voice | workflow
  status       String   @default("active") // active | paused | draft
  config       String   @default("{}") // JSON config for the agent
  systemPrompt String   @default("") // Agent-specific system prompt override
  qrCodeUrl    String?  // For barista agents - URL to the public chat page
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model Lead {
  id              String    @id @default(cuid())
  businessId      String
  customerName    String?
  customerContact String?
  intent          String?
  source          String    @default("ai_chat") // ai_chat | barista | manual | leadgen | whatsapp
  status          String    @default("new") // new | contacted | qualified | converted | lost
  createdAt       DateTime  @default(now())
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model Conversation {
  id          String    @id @default(cuid())
  businessId  String
  agentId     String?   // Optional: for per-agent conversations
  role        String    // user | assistant
  content     String
  createdAt   DateTime  @default(now())
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([agentId])
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String
  plan      String   @default("free") // free | starter | pro | agency
  status    String   @default("active") // active | cancelled | expired
  startDate DateTime @default(now())
  endDate   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Payment {
  id            String   @id @default(cuid())
  userId        String
  businessId    String?
  amount        Float
  currency      String   @default("EGP")
  plan          String   // starter | pro | agency
  method        String   @default("instapay") // instapay
  screenshotUrl String?  // Uploaded screenshot of payment
  status        String   @default("pending") // pending | approved | rejected
  adminNote     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Workflow {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String   @default("")
  trigger     String   // new_lead | new_order | schedule | manual | webhook
  triggerConfig String @default("{}") // JSON config for trigger
  actions     String   @default("[]") // JSON array of actions
  status      String   @default("draft") // draft | active | paused
  lastRunAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model KnowledgeDoc {
  id          String   @id @default(cuid())
  businessId  String
  title       String
  content     String
  category    String   @default("general") // general | policy | onboarding | procedures | faq
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}
